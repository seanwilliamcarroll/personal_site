# Supply-chain guards (CLAUDE.md, "Dependencies"). Need npm 11.16+,
# which comes with the Node in .nvmrc.

# Install only versions published at least a week ago: most hijacked
# releases are found and pulled within days.
min-release-age=7

# A dependency's install script (preinstall, install, postinstall) fails
# the install unless package.json's allowScripts approves it.
strict-allow-scripts=true

# Refuse an npm or Node outside package.json's engines.
engine-strict=true
