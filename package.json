{
  "name": "astro-site",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11.16"
  },
  "version": "5.5.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist && cp -r dist/pagefind public/",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check:og": "node scripts/check-og.mjs",
    "build:demos": "PUBLIC_SHOW_DRAFTS=true astro build --outDir dist-demos",
    "test:demos": "npm run build:demos && playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "dayjs": "^1.11.23",
    "lodash.kebabcase": "^4.1.1",
    "physics-engine": "https://github.com/seanwilliamcarroll/physics/releases/download/v0.1.0/physics-engine-0.1.0.tgz",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@pagefind/default-ui": "^1.6.0",
    "@playwright/test": "^1.65.0",
    "@shikijs/transformers": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    },
    "satori": {
      "fflate": "^0.7.5"
    },
    "minimatch@>=7 <11.0.1": "^11.0.1"
  },
  "allowScripts": {
    "fsevents": false
  }
}
